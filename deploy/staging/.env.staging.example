COMPOSE_PROJECT_NAME=filmiqoo-staging

FILMIQOO_API_IMAGE=ghcr.io/awmirai/filmiqoo-api:<commit-sha>
FILMIQOO_VERSION=staging-<commit-sha>
FILMIQOO_COMMIT=<commit-sha>
FILMIQOO_DOMAIN=staging-api.example.com
FILMIQOO_TLS_EMAIL=ops@example.com

POSTGRES_DB=filmiqoo_staging
POSTGRES_USER=filmiqoo
POSTGRES_PASSWORD=replace-with-strong-staging-database-password
REDIS_PASSWORD=replace-with-strong-staging-redis-password

APP_ENV=production
HTTP_ADDR=:8080
PUBLIC_API_BASE_URL=https://staging-api.example.com
ALLOWED_ORIGINS=https://staging.example.com

JWT_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_INGEST_SECRET=replace-with-at-least-32-random-characters
PLAYBACK_SIGNING_SECRET=replace-with-at-least-32-random-characters
OPS_SECRET=replace-with-at-least-32-random-characters

OBJECT_STORAGE_ENDPOINT=https://s3-internal-or-provider.example.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://staging-media.example.com
OBJECT_STORAGE_BUCKET=filmiqoo-staging
OBJECT_STORAGE_KEY=replace-with-staging-access-key
OBJECT_STORAGE_SECRET=replace-with-at-least-32-random-characters

TMDB_TOKEN=
TELEGRAM_STREAM_BASE_URL=https://telegram-stream-staging.example.com
PLAYBACK_TOKEN_TTL_SECONDS=300
TELEGRAM_STREAM_HASH_LENGTH=6

AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
MAX_JSON_BODY_BYTES=2097152
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=20
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=60
AUTHENTICATED_WRITE_RATE_LIMIT_PER_MINUTE=300
PUBLIC_SEARCH_RATE_LIMIT_PER_MINUTE=120
REALTIME_CONNECTIONS_PER_USER=8
UPLOAD_DAILY_COUNT_LIMIT=100
UPLOAD_DAILY_BYTES_LIMIT=10737418240
POSTGRES_MAX_CONNS=30
POSTGRES_MIN_CONNS=3
REDIS_POOL_SIZE=50
API_REQUEST_TIMEOUT_SECONDS=20

FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
PUSH_MAX_ATTEMPTS=6

TELEGRAM_INGEST_MAX_ATTEMPTS=8
TELEGRAM_INGEST_RETRY_BASE_SECONDS=30
TELEMETRY_RETENTION_DAYS=14
