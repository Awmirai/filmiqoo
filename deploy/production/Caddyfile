{
    email {$FILMIQOO_TLS_EMAIL}
}

{$FILMIQOO_DOMAIN} {
    encode zstd gzip
    reverse_proxy api:8080

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    log {
        output stdout
        format json
    }
}

{$FILMIQOO_MEDIA_DOMAIN} {
    encode zstd gzip
    reverse_proxy minio:9000

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    log {
        output stdout
        format json
    }
}
