FILMIQOO_API_IMAGE=ghcr.io/awmirai/filmiqoo-api:<commit-sha>
FILMIQOO_VERSION=1.0.0
FILMIQOO_COMMIT=<commit-sha>
FILMIQOO_DOMAIN=api.example.com
FILMIQOO_TLS_EMAIL=ops@example.com

POSTGRES_DB=filmiqoo
POSTGRES_USER=filmiqoo
POSTGRES_PASSWORD=replace-with-strong-database-password
REDIS_PASSWORD=replace-with-strong-redis-password

# Copy the remaining API variables from ../../.env.example into .env.production.
# APP_ENV must be production and DATABASE_URL/REDIS_* are injected by compose.

# The database is on the private Docker network and is not published externally.
ALLOW_INTERNAL_PLAINTEXT_DATABASE=true

# Store this file outside Git and restrict permissions (chmod 600).
# BACKUP_PASSWORD_FILE is consumed by backup.sh/restore.sh, not by the API container.
BACKUP_PASSWORD_FILE=./backup-password.txt
