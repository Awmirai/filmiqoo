FILMIQOO_API_IMAGE=filmiqoo-api:local
FILMIQOO_API_ENV_FILE=.env.production
FILMIQOO_VERSION=1.0.0
FILMIQOO_COMMIT=<commit-sha>
FILMIQOO_DOMAIN=api.filmiqo.com
FILMIQOO_MEDIA_DOMAIN=media.filmiqo.com
FILMIQOO_TLS_EMAIL=ops@filmiqo.com

POSTGRES_DB=filmiqoo
POSTGRES_USER=filmiqoo
POSTGRES_PASSWORD=replace-with-strong-database-password
REDIS_PASSWORD=replace-with-strong-redis-password

MINIO_ROOT_USER=replace-with-random-minio-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
OBJECT_STORAGE_BUCKET=filmiqoo-media

# Copy the remaining API variables from ../../.env.example into .env.production.
# APP_ENV must be production and DATABASE_URL/REDIS/object-storage connection values
# are injected by compose. The public object-storage endpoint is served by Caddy at
# FILMIQOO_MEDIA_DOMAIN.

ALLOW_INTERNAL_PLAINTEXT_DATABASE=true

# Store this file outside Git and restrict permissions (chmod 600).
# BACKUP_PASSWORD_FILE is consumed by backup.sh/restore.sh, not by the API container.
BACKUP_PASSWORD_FILE=./backup-password.txt
