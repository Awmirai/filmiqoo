APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://filmiqoo:filmiqoo@postgres:5432/filmiqoo?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
TMDB_TOKEN=
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://10.0.2.2:9000
OBJECT_STORAGE_BUCKET=filmiqoo-media
OBJECT_STORAGE_KEY=filmiqoo
OBJECT_STORAGE_SECRET=filmiqoo-dev-secret
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/filmiqoo-media
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHANNEL=

TELEGRAM_INGEST_SECRET=replace-with-random-internal-secret
TELEGRAM_STREAM_BASE_URL=http://host.docker.internal:8081
PLAYBACK_SIGNING_SECRET=replace-with-another-long-random-secret
PLAYBACK_TOKEN_TTL_SECONDS=300
PUBLIC_API_BASE_URL=http://localhost:8080
TELEGRAM_STREAM_HASH_LENGTH=6
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30

# Production hardening
# In production, list exact HTTPS origins separated by commas. Do not use *.
ALLOWED_ORIGINS=
MAX_JSON_BODY_BYTES=2097152
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=8
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=30
AUTHENTICATED_WRITE_RATE_LIMIT_PER_MINUTE=240
BUILD_VERSION=dev
BUILD_COMMIT=unknown

# Firebase Cloud Messaging (backend HTTP v1)
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
PUSH_MAX_ATTEMPTS=6

# Android Firebase client values used by Gradle build environment
FILMIQOO_FIREBASE_API_KEY=
FILMIQOO_FIREBASE_APP_ID=
FILMIQOO_FIREBASE_PROJECT_ID=
FILMIQOO_FIREBASE_SENDER_ID=

# Reliable Telegram metadata ingest
TELEGRAM_INGEST_MAX_ATTEMPTS=8
TELEGRAM_INGEST_RETRY_BASE_SECONDS=30

# Anonymous crash/operational telemetry retention
TELEMETRY_RETENTION_DAYS=30
